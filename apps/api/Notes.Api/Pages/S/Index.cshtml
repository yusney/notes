@page "{token}"
@model Notes.Api.Pages.S.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Note!.Title;
    ViewData["OgTitle"] = Model.Note.Title;
    ViewData["OgDescription"] = Model.Note.Title + " — shared note";
}

<article>
    <header>
        <h1>@Model.Note.Title</h1>
        <div class="meta">
            <span>Created @Model.Note.CreatedAt.ToString("MMMM d, yyyy")</span>
            @if (Model.Note.UpdatedAt.HasValue)
            {
                <span> &middot; Updated @Model.Note.UpdatedAt.Value.ToString("MMMM d, yyyy")</span>
            }
            @if (Model.Note.ExpiresAt.HasValue)
            {
                var expiresAt = Model.Note.ExpiresAt.Value;
                var diff = expiresAt - DateTime.UtcNow;

                string cssClass;
                string label;

                if (diff.TotalMinutes < 1)
                {
                    cssClass = "expiry expiry--urgent";
                    label = "Expires in less than a minute";
                }
                else if (diff.TotalHours < 1)
                {
                    cssClass = "expiry expiry--urgent";
                    label = $"Expires in {(int)diff.TotalMinutes}m";
                }
                else if (diff.TotalHours < 24)
                {
                    cssClass = "expiry expiry--warning";
                    label = $"Expires in {(int)diff.TotalHours}h {diff.Minutes}m";
                }
                else if (diff.TotalDays < 2)
                {
                    cssClass = "expiry";
                    label = "Expires tomorrow";
                }
                else
                {
                    cssClass = "expiry";
                    label = $"Expires {expiresAt.ToString("MMMM d, yyyy")}";
                }

                <span class="@cssClass"> &middot; @label</span>
            }
        </div>
    </header>

    <div class="note-content">
        @Html.Raw(Model.Note.SanitizedContent)
    </div>

    <a class="back-to-top" href="#">↑ Back to top</a>
</article>
