# ============================================================
# Notes - Gestor de Conocimiento Personal
# Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
POSTGRES_DB=notes_db
POSTGRES_USER=notes_user
POSTGRES_PASSWORD=change_me_strong_password

# ── ASP.NET Core ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── Connection String (used by API in docker-compose) ───────
# This is assembled from POSTGRES_* vars above by docker-compose
# For standalone runs, set it directly:
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=notes_db;Username=notes_user;Password=change_me

# ── JWT Authentication ───────────────────────────────────────
# Must be at least 32 characters long for HS256
Jwt__Secret=replace_with_a_long_random_secret_at_least_32_chars
Jwt__Issuer=notes-api
Jwt__Audience=notes-client

# ── API URL (used by Tauri desktop app) ──────────────────────
# Development: http://localhost:8080
# Production (VPS): https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8080

# ── Google OAuth ─────────────────────────────────────────────
# Required only if Google login is enabled.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include:  <PublicBaseUrl>/api/auth/oauth/google/callback
OAuth__Google__ClientId=your_google_client_id
OAuth__Google__ClientSecret=your_google_client_secret

# ── GitHub OAuth ─────────────────────────────────────────────
# Required only if GitHub login is enabled.
# Create credentials at: https://github.com/settings/developers
# Authorized callback URL must include: <PublicBaseUrl>/api/auth/oauth/github/callback
OAuth__GitHub__ClientId=your_github_client_id
OAuth__GitHub__ClientSecret=your_github_client_secret

# ── OAuth Public Base URL ────────────────────────────────────
# Required in production when the API runs behind a reverse proxy (Dokploy, nginx, Traefik, etc.)
# that terminates TLS.  Without this the callback URL sent to Google/GitHub will use http://
# instead of https://, causing a redirect_uri_mismatch error.
#
# Set it to the public HTTPS root of your API, no trailing slash.
# Example: OAuth__PublicBaseUrl=https://notes-api.donduque.dev
#
# Leave empty or omit for local development (http:// is fine locally).
OAuth__PublicBaseUrl=
